{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bareeq-shop": {
      "root": "artifacts/bareeq-shop",
      "framework": "nextjs",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "bareeq-shop"
      }
    }
  ]
}
